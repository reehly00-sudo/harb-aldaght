# المنفذ
PORT=3000
# مسار ملف قاعدة البيانات (SQLite)
DB_PATH=./data/game.db
# مفتاح المؤسس: مطلوب للدخول باسم Keep. إن تركته فارغًا يولّد السيرفر مفتاحًا ويطبعه عند أول تشغيل.
FOUNDER_KEY=
# حدود الغرفة
